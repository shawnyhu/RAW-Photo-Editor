+bool probeVulkanRenderer(std::string &message) {
+  const auto checkTable = [&](const char *name, size_t elements) {
+    std::error_code ec;
+    if (std::filesystem::file_size(findResourcePath(name), ec) == elements * sizeof(float) && !ec) {
+      return true;
+    }
+    message = std::string("Missing or invalid Spektrafilm table: ") + name;
+    return false;
+  };
+  if (!checkTable("SpektraHanatos2025Spectra.f32", hanatosSpectraLutInfo().elementCount) ||
+      !checkTable("SpektraOutputGamutCompression.f32", kSpektraOutputGamutCompressionElementCount)) {
+    return false;
+  }
+  // Creating the shared backend loads every SPIR-V module and compute pipeline.
+  auto backend = acquireVulkanSharedBackend(message);
+  if (!backend) return false;
+  message = backend->physicalDeviceProperties.deviceName;
+  return true;
+}
